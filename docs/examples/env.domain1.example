# Environment for Domain 1
# Copy to inputs/.env.domain1 and fill in values

OPENROUTER_API_KEY=your_openrouter_key_or_domain1
PROJECT_PATH=/app/project
PROJECT_DOMAIN=domain1.com

# Google APIs
GA4_CREDENTIALS_PATH=/app/inputs/ga4-credentials.json
GA4_PROPERTY_ID=your_ga4_property_id_1
GSC_CREDENTIALS_PATH=/app/inputs/gsc-credentials.json
GSC_SITE_URL=https://www.domain1.com/

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional: Schedule (cron times)
SCHEDULE_MONITOR=08:00
SCHEDULE_AUDIT=10:00,22:00