# Environment for Domain 3
# Copy to inputs/.env.domain3 and fill in values

OPENROUTER_API_KEY=your_openrouter_key_or_domain3
PROJECT_PATH=/app/project
PROJECT_DOMAIN=domain3.com

# Google APIs
GA4_CREDENTIALS_PATH=/app/inputs/ga4-credentials.json
GA4_PROPERTY_ID=your_ga4_property_id_3
GSC_CREDENTIALS_PATH=/app/inputs/gsc-credentials.json
GSC_SITE_URL=https://www.domain3.com/

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional: Schedule (cron times)
SCHEDULE_MONITOR=10:00
SCHEDULE_AUDIT=12:00,00:00