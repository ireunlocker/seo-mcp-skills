# Environment for Domain 2
# Copy to inputs/.env.domain2 and fill in values

OPENROUTER_API_KEY=your_openrouter_key_or_domain2
PROJECT_PATH=/app/project
PROJECT_DOMAIN=domain2.com

# Google APIs
GA4_CREDENTIALS_PATH=/app/inputs/ga4-credentials.json
GA4_PROPERTY_ID=your_ga4_property_id_2
GSC_CREDENTIALS_PATH=/app/inputs/gsc-credentials.json
GSC_SITE_URL=https://www.domain2.com/

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional: Schedule (cron times)
SCHEDULE_MONITOR=09:00
SCHEDULE_AUDIT=11:00,23:00