# SEO MCP Skills - Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control!

# =============================================================================
# AI PROVIDER CONFIGURATION (choose at least one)
# =============================================================================

# OpenRouter API Key (supports multiple models: DeepSeek, Claude, Gemini, GPT-4o, etc.)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API Key (free tier available)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic API Key (Claude models)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# GOOGLE APIs CONFIGURATION
# =============================================================================

# Path to Google Service Account JSON key file
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GA4_CREDENTIALS_PATH=inputs/ga4-service-account.json
GSC_CREDENTIALS_PATH=inputs/gsc-service-account.json

# Google Analytics 4 Property ID (numeric, e.g., 123456789)
GA4_PROPERTY_ID=

# Google Search Console Site URL (e.g., https://example.com/)
GSC_SITE_URL=

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

# Path to your web project (where SEO changes will be applied)
PROJECT_PATH=/path/to/your/web/project

# Frontend subdirectory (if using monorepo)
FRONTEND_PATH=app/frontend

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (get from @userinfobot or group)
TELEGRAM_CHAT_ID=

# Backend API URL for sending reports/metrics
BACKEND_API_URL=

# =============================================================================
# MCP SERVERS CONFIGURATION (Optional - for advanced mode)
# =============================================================================

# JSON array of MCP server configurations
# Example: [{"name":"browser","command":"npx","args":["-y","@modelcontextprotocol/server-puppeteer"]}]
MCP_SERVERS=

# =============================================================================
# GIT CONFIGURATION (Optional)
# =============================================================================

# Git branch for auto-commits (default: main)
GIT_BRANCH=main

# Webhook secret for git pull webhook server
WEBHOOK_SECRET=